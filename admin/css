/* ================================================
   FRESHMART ADMIN — STYLESHEET
   Google Fonts: Playfair Display + Plus Jakarta Sans
   ================================================ */

@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

:root {
    --bg:        #f7f6f2;
    --bg2:       #ffffff;
    --bg3:       #f0ede6;
    --border:    #e5e0d8;
    --green:     #2d6a4f;
    --green2:    #40916c;
    --green3:    #74c69d;
    --green-bg:  #d8f3dc;
    --text:      #1a1a1a;
    --text2:     #4a4a4a;
    --text3:     #888880;
    --accent:    #e76f51;
    --accent2:   #f4a261;
    --blue:      #457b9d;
    --red:       #c1121f;
    --yellow:    #e9c46a;
    --purple:    #7b2d8b;
    --sidebar-w: 260px;
    --radius:    12px;
    --shadow:    0 2px 12px rgba(0,0,0,0.07);
    --shadow-lg: 0 8px 32px rgba(0,0,0,0.12);
    --font-head: 'Playfair Display', serif;
    --font-body: 'Plus Jakarta Sans', sans-serif;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    font-size: 14px;
}

a { text-decoration: none; color: inherit; }

/* ── SCROLLBAR ── */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: var(--bg3); }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }

/* ── SIDEBAR ── */
.sidebar {
    width: var(--sidebar-w);
    background: var(--green);
    min-height: 100vh;
    position: fixed;
    left:0; top:0;
    display: flex;
    flex-direction: column;
    z-index: 100;
    box-shadow: 4px 0 20px rgba(0,0,0,0.1);
}

.sidebar-logo {
    padding: 28px 24px 22px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

.sidebar-logo .brand {
    font-family: var(--font-head);
    font-size: 22px;
    font-weight: 800;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 10px;
}

.sidebar-logo .brand .logo-box {
    width: 38px; height: 38px;
    background: rgba(255,255,255,0.15);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
}

.sidebar-logo small {
    display: block;
    color: rgba(255,255,255,0.55);
    font-size: 11px;
    margin-top: 3px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 500;
}

.sidebar-nav { flex:1; padding: 16px 12px; overflow-y: auto; }

.nav-section {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    padding: 14px 12px 6px;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 10px 14px;
    border-radius: 9px;
    margin-bottom: 2px;
    color: rgba(255,255,255,0.7);
    font-size: 13.5px;
    font-weight: 500;
    transition: all 0.18s;
    cursor: pointer;
}

.nav-item:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
}

.nav-item.active {
    background: rgba(255,255,255,0.18);
    color: #fff;
    font-weight: 600;
}

.nav-item .ni { font-size: 17px; width: 22px; text-align: center; }

.sidebar-footer {
    padding: 16px 12px;
    border-top: 1px solid rgba(255,255,255,0.1);
}

.admin-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(255,255,255,0.1);
}

.admin-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 14px;
    color: #fff; flex-shrink: 0;
}

.admin-info .aname { font-size: 13px; font-weight: 600; color: #fff; }
.admin-info .arole { font-size: 10px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px; }

.logout-link {
    margin-left: auto;
    color: rgba(255,255,255,0.45);
    font-size: 18px;
    cursor: pointer;
    transition: color 0.15s;
    padding: 4px;
}
.logout-link:hover { color: #ffadad; }

/* ── MAIN ── */
.main {
    margin-left: var(--sidebar-w);
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* ── TOPBAR ── */
.topbar {
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
    padding: 0 30px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky; top:0; z-index: 50;
    box-shadow: var(--shadow);
}

.topbar-left h1 {
    font-family: var(--font-head);
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
}

.topbar-left .breadcrumb {
    font-size: 11px;
    color: var(--text3);
    margin-top: 1px;
}

.topbar-right { display: flex; align-items: center; gap: 14px; }

.topbar-time {
    font-size: 12px;
    color: var(--text3);
    background: var(--bg3);
    padding: 5px 12px;
    border-radius: 20px;
    border: 1px solid var(--border);
}

/* ── CONTENT ── */
.page-content { padding: 28px 30px; flex: 1; }

/* ── FLASH ── */
.flash {
    padding: 13px 18px;
    border-radius: var(--radius);
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    font-weight: 500;
    box-shadow: var(--shadow);
}
.flash span { font-size: 16px; }
.flash-success { background: var(--green-bg); border: 1px solid var(--green3); color: var(--green); }
.flash-error   { background: #ffe5e5; border: 1px solid #ffb3b3; color: var(--red); }
.flash-info    { background: #dbeafe; border: 1px solid #93c5fd; color: var(--blue); }

/* ── STAT CARDS ── */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 26px;
}

.stat-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
}

.stat-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.stat-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 14px;
}

.stat-icon {
    width: 46px; height: 46px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
}

.stat-icon.green  { background: var(--green-bg); }
.stat-icon.orange { background: #fef3c7; }
.stat-icon.blue   { background: #dbeafe; }
.stat-icon.red    { background: #ffe4e6; }

.stat-trend {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 20px;
}
.stat-trend.up   { background: var(--green-bg); color: var(--green); }
.stat-trend.down { background: #ffe4e6; color: var(--red); }

.stat-value {
    font-family: var(--font-head);
    font-size: 30px;
    font-weight: 800;
    color: var(--text);
    line-height: 1;
    margin-bottom: 5px;
}

.stat-label {
    font-size: 12px;
    color: var(--text3);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

/* ── CARD ── */
.card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
}

.card-header {
    padding: 18px 22px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-title {
    font-family: var(--font-head);
    font-size: 16px;
    font-weight: 700;
}

.card-body { padding: 22px; }

/* ── TABLE ── */
.table-wrap { overflow-x: auto; }

table { width: 100%; border-collapse: collapse; font-size: 13.5px; }

thead tr { background: var(--bg3); border-bottom: 2px solid var(--border); }

th {
    padding: 11px 16px;
    text-align: left;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text3);
    white-space: nowrap;
}

td {
    padding: 13px 16px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
    color: var(--text2);
}

tbody tr:last-child td { border-bottom: none; }
tbody tr:hover td { background: #fafaf7; }

/* ── BADGE ── */
.badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 11px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3px;
}

.badge::before {
    content: '';
    width: 5px; height: 5px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
}

.badge-active, .badge-completed, .badge-delivered { background: var(--green-bg); color: var(--green); }
.badge-inactive, .badge-failed, .badge-cancelled { background: #ffe4e6; color: var(--red); }
.badge-pending  { background: #fef3c7; color: #92400e; }
.badge-shipped  { background: #dbeafe; color: var(--blue); }

/* ── BUTTONS ── */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 18px;
    border-radius: 9px;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    transition: all 0.18s;
    text-decoration: none;
}

.btn-primary {
    background: var(--green);
    color: #fff;
    box-shadow: 0 2px 8px rgba(45,106,79,0.3);
}
.btn-primary:hover { background: var(--green2); transform: translateY(-1px); box-shadow: 0 4px 14px rgba(45,106,79,0.35); }

.btn-ghost {
    background: var(--bg3);
    color: var(--text2);
    border: 1px solid var(--border);
}
.btn-ghost:hover { background: var(--border); color: var(--text); }

.btn-danger {
    background: #fff0f0;
    color: var(--red);
    border: 1px solid #ffc5c5;
}
.btn-danger:hover { background: #ffe4e6; }

.btn-orange {
    background: #fff4ed;
    color: var(--accent);
    border: 1px solid #fed7aa;
}
.btn-orange:hover { background: #fed7aa; }

.btn-sm { padding: 5px 11px; font-size: 12px; border-radius: 7px; }
.btn-icon { padding: 6px 9px; }

/* ── FORMS ── */
.form-group { margin-bottom: 18px; }

label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: var(--text3);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 7px;
}

input[type=text], input[type=email], input[type=number],
input[type=password], textarea, select {
    width: 100%;
    background: var(--bg3);
    border: 1.5px solid var(--border);
    border-radius: 9px;
    padding: 10px 14px;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 14px;
    outline: none;
    transition: all 0.18s;
}

input:focus, textarea:focus, select:focus {
    border-color: var(--green2);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(64,145,108,0.12);
}

select option { background: #fff; }
textarea { resize: vertical; min-height: 90px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }

/* ── SEARCH ── */
.search-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    background: var(--bg3);
    border: 1.5px solid var(--border);
    border-radius: 9px;
    width: 260px;
    transition: all 0.18s;
}
.search-bar:focus-within {
    border-color: var(--green2);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(64,145,108,0.1);
}
.search-bar span { font-size: 15px; color: var(--text3); flex-shrink: 0; }
.search-bar input {
    border: none; background: transparent;
    padding: 9px 0; font-size: 13px;
    color: var(--text); outline: none; width: 100%;
    box-shadow: none;
}
.search-bar input::placeholder { color: var(--text3); }

/* ── FILTERS ROW ── */
.filters-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    background: var(--bg3);
}
.filters-row select { width: auto; padding: 8px 12px; font-size: 13px; }

/* ── MODAL ── */
.modal-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(26,26,26,0.6);
    backdrop-filter: blur(6px);
    z-index: 200;
    align-items: center;
    justify-content: center;
    padding: 20px;
}
.modal-overlay.open { display: flex; }

.modal {
    background: var(--bg2);
    border-radius: 16px;
    width: 100%;
    max-width: 560px;
    max-height: 92vh;
    overflow-y: auto;
    box-shadow: var(--shadow-lg);
    animation: popIn 0.22s cubic-bezier(0.34,1.56,0.64,1);
}
.modal-lg { max-width: 720px; }
.modal-xl { max-width: 900px; }

@keyframes popIn {
    from { transform: scale(0.92) translateY(16px); opacity: 0; }
    to   { transform: scale(1) translateY(0); opacity: 1; }
}

.modal-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg3);
    border-radius: 16px 16px 0 0;
}

.modal-title {
    font-family: var(--font-head);
    font-size: 17px;
    font-weight: 700;
}

.modal-close {
    width: 30px; height: 30px;
    border-radius: 8px;
    background: var(--bg2);
    border: 1px solid var(--border);
    color: var(--text3);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px;
    font-family: var(--font-body);
    transition: all 0.15s;
}
.modal-close:hover { background: #ffe4e6; color: var(--red); border-color: #ffc5c5; }

.modal-body { padding: 24px; }
.modal-footer {
    padding: 16px 24px;
    border-top: 1px solid var(--border);
    display: flex; gap: 10px; justify-content: flex-end;
    background: var(--bg3);
    border-radius: 0 0 16px 16px;
}

/* ── PRODUCT THUMB ── */
.product-thumb {
    width: 46px; height: 46px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--border);
    background: var(--bg3);
}
.product-thumb-placeholder {
    width: 46px; height: 46px;
    border-radius: 10px;
    background: var(--bg3);
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; flex-shrink: 0;
}

/* ── PRODUCT GRID ── */
.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 18px;
    padding: 22px;
}

.product-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: all 0.2s;
    position: relative;
    box-shadow: var(--shadow);
}
.product-card:hover {
    border-color: var(--green3);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
}

.product-card-img {
    width: 100%; height: 155px;
    object-fit: cover; display: block;
    background: var(--bg3);
}
.product-card-img-placeholder {
    width: 100%; height: 155px;
    background: var(--bg3);
    display: flex; align-items: center; justify-content: center;
    font-size: 44px;
}

.product-card-body { padding: 13px; }
.product-card-cat {
    font-size: 10px; text-transform: uppercase;
    letter-spacing: 1px; color: var(--green2);
    font-weight: 700; margin-bottom: 4px;
}
.product-card-name {
    font-family: var(--font-head);
    font-weight: 700; font-size: 14px;
    margin-bottom: 8px; line-height: 1.3;
    color: var(--text);
}
.product-card-price {
    display: flex; align-items: center; gap: 7px; margin-bottom: 10px;
}
.product-card-price .cur { font-weight: 800; font-size: 15px; color: var(--green); }

.product-card-footer {
    display: flex; align-items: center;
    justify-content: space-between;
    padding-top: 9px;
    border-top: 1px solid var(--border);
}

.product-card-stock { font-size: 11px; font-weight: 600; color: var(--text3); }

.card-badge {
    position: absolute; top: 9px;
    font-size: 10px; font-weight: 700;
    padding: 3px 9px; border-radius: 20px;
}
.card-badge-left { left: 9px; background: rgba(233,196,106,0.92); color: #5c3d00; }
.card-badge-right { right: 9px; background: rgba(193,18,31,0.88); color: #fff; }

/* ── VIEW TOGGLE ── */
.view-toggle { display: flex; gap: 4px; }
.view-btn {
    width: 34px; height: 34px;
    border-radius: 8px;
    border: 1.5px solid var(--border);
    background: var(--bg3);
    color: var(--text3);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; transition: all 0.15s; text-decoration: none;
}
.view-btn.active, .view-btn:hover {
    background: var(--green-bg);
    border-color: var(--green3);
    color: var(--green);
}

/* ── EMPTY STATE ── */
.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text3);
}
.empty-state .ei { font-size: 48px; margin-bottom: 14px; }
.empty-state p { font-size: 14px; }

/* ── ORDER DETAIL ── */
.order-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 20px;
}
.info-box {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 16px;
}
.info-box-label {
    font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 1px;
    color: var(--text3); margin-bottom: 6px;
}
.info-box-value { font-size: 14px; font-weight: 600; color: var(--text); }
.info-box-sub { font-size: 12px; color: var(--text3); margin-top: 2px; }

/* ── SUMMARY TABLE ── */
.summary-row {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 13px;
    color: var(--text2);
}
.summary-row.total {
    border-top: 2px solid var(--border);
    margin-top: 6px;
    padding-top: 12px;
    font-weight: 800;
    font-size: 16px;
    color: var(--text);
}
.summary-row.total span:last-child { color: var(--green); }

/* ── RESPONSIVE ── */
@media (max-width: 1200px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
    .sidebar { transform: translateX(-100%); }
    .main { margin-left: 0; }
    .stats-grid { grid-template-columns: 1fr 1fr; }
    .form-row, .form-row-3 { grid-template-columns: 1fr; }
    .page-content { padding: 18px; }
    .topbar { padding: 0 18px; }
}
